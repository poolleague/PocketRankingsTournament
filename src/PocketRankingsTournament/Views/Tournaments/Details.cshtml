@model TournamentDetailViewModel
@{ ViewData["Title"] = Model.Event.Name; var activeMatches = Model.Competition.Rounds.SelectMany(round => round.Matches).Count(match => match.Status is MatchStatus.Called or MatchStatus.InProgress); }
<section class="event-hero" id="details"><a class="back-link" href="/tournaments">← All tournaments</a><div class="event-title-row"><div><p class="eyebrow">@TournamentLabels.Status(Model.Event.Status)</p><h1>@Model.Event.Name</h1><p>@Model.Event.Venue · @Model.Event.Locality · @Model.Event.StartsAt.ToString("dddd, MMMM d 'at' h:mm tt")</p></div><span class="status live">Live</span></div></section>
<nav class="event-tabs" aria-label="Tournament sections"><a class="active" href="#bracket" aria-current="page">@(Model.Competition.Format == CompetitionFormat.RoundRobin ? "Schedule" : "Bracket")</a>@if (Model.Competition.Format == CompetitionFormat.RoundRobin) { <a href="#standings">Standings</a> }@if (Model.Competition.Status == CompetitionStatus.Complete) { <a href="#placements">Placements</a> }<a href="#players">Players <span>@Model.Competition.Participants.Count</span></a><a href="#payouts">Payouts</a><a href="#details">Details</a><button type="button" data-print-page>Print</button></nav>
<section class="now-strip" aria-label="Current tournament activity"><div><span class="pulse" aria-hidden="true"></span><strong>@activeMatches matches active</strong></div><p>Players: check the table shown on your match card before you start.</p></section>
<section class="competition-summary"><div><span class="ball-badge large">@(Model.Competition.Discipline == PoolDiscipline.NineBall ? "9" : "8")</span><span><strong>@Model.Competition.Name</strong><small>@TournamentLabels.Format(Model.Competition.Format)</small></span></div><dl><div><dt>Winners side</dt><dd>Race to @Model.Competition.WinnersRaceTo</dd></div><div><dt>Elimination side</dt><dd>Race to @(Model.Competition.LosersRaceTo ?? Model.Competition.WinnersRaceTo)</dd></div><div><dt>Field</dt><dd>@Model.Competition.Participants.Count players</dd></div><div><dt>Rules</dt><dd>@Model.Competition.RulesLabel</dd></div></dl></section>
<section class="bracket-section" id="bracket" aria-labelledby="bracket-heading"><div class="section-heading"><div><p class="eyebrow">Live draw</p><h2 id="bracket-heading">@(Model.Competition.Format == CompetitionFormat.RoundRobin ? "Schedule" : "Bracket")</h2></div><p>Scroll across rounds or read them top to bottom on a phone.</p></div>@foreach (var bracket in Model.Competition.Rounds.GroupBy(round => round.Bracket)) { <section class="bracket-group" aria-labelledby="@($"bracket-{bracket.Key}")"><h3 id="@($"bracket-{bracket.Key}")">@bracket.Key @(Model.Competition.Format == CompetitionFormat.RoundRobin ? "schedule" : "bracket")</h3><div class="bracket-board">@foreach (var round in bracket) { <section class="round-column" aria-labelledby="@round.Id"><h4 id="@round.Id">@round.Name</h4>@foreach (var match in round.Matches) { <article class="match-card @match.Status.ToString().ToLowerInvariant()"><div class="match-meta"><span>@match.Id</span><span>@match.TableName</span></div><div class="entrant @(match.WinnerId == match.EntrantOne?.Id ? "winner" : null)"><span>@(match.EntrantOne?.DisplayName ?? "To be decided")</span><strong>@match.EntrantOneScore</strong></div><div class="entrant @(match.WinnerId == match.EntrantTwo?.Id ? "winner" : null)"><span>@(match.EntrantTwo?.DisplayName ?? "To be decided")</span><strong>@match.EntrantTwoScore</strong></div><div class="match-status">@TournamentLabels.MatchStatus(match.Status)</div></article> }</section> }</div></section> }</section>
@if (Model.Competition.Format == CompetitionFormat.RoundRobin)
{
    var standings = TournamentStandings.Calculate(Model.Competition);
    <section class="page-section" id="standings" aria-labelledby="standings-heading"><div class="section-heading"><div><p class="eyebrow">Updated from confirmed scores</p><h2 id="standings-heading">Standings</h2></div></div><div class="standings-table public-standings" role="table" aria-label="Round-robin standings"><div role="row" class="standings-heading"><span role="columnheader">Pos</span><span role="columnheader">Entrant</span><span role="columnheader">Played</span><span role="columnheader">Won</span><span role="columnheader">Lost</span><span role="columnheader">For</span><span role="columnheader">Against</span><span role="columnheader">Diff</span></div>@foreach (var row in standings) { <div role="row"><strong role="cell">@row.Position</strong><span role="cell">@row.Entrant.DisplayName</span><span role="cell">@row.Played</span><span role="cell">@row.Wins</span><span role="cell">@row.Losses</span><span role="cell">@row.ScoreFor</span><span role="cell">@row.ScoreAgainst</span><span role="cell">@(row.ScoreDifference > 0 ? "+" : "")@row.ScoreDifference</span></div> }</div></section>
}
@{ var placements = TournamentPlacements.Calculate(Model.Competition); }
@if (placements.Count > 0)
{
    <section class="page-section" id="placements" aria-labelledby="placements-heading"><div class="section-heading"><div><p class="eyebrow">Official finish</p><h2 id="placements-heading">Placements</h2></div></div><ol class="placement-list">@foreach (var placement in placements) { <li><strong>@placement.Label</strong><span>@placement.Entrant.DisplayName</span></li> }</ol></section>
}
<section class="page-section" id="players" aria-labelledby="players-heading"><div class="section-heading"><div><p class="eyebrow">The field</p><h2 id="players-heading">Players</h2></div></div><ol class="player-list">@foreach (var player in Model.Competition.Participants.Where(player => player.RegistrationStatus is RegistrationStatus.Registered or RegistrationStatus.CheckedIn).OrderBy(player => player.Seed)) { <li><span class="seed">@player.Seed</span><strong>@player.DisplayName</strong>@if (player.Handicap is not null) { <span>Rating @player.Handicap</span> }</li> }</ol></section>
@{ var displayedPayouts = Model.Competition.Payouts ?? Model.Event.Payouts; }
<section class="page-section" id="payouts" aria-labelledby="payouts-heading"><div class="section-heading"><div><p class="eyebrow">Published before the draw</p><h2 id="payouts-heading">Payouts</h2></div></div>@if (displayedPayouts.Count == 0) { <p class="empty-row">No payout schedule has been published for this competition.</p> } else { <div class="payout-grid">@foreach (var payout in displayedPayouts) { <div><span>@payout.Label</span><strong>@payout.Amount.ToString("C0")</strong></div> }</div> }<p class="fine-print">Displayed for transparency. Pocket Rankings does not collect or hold these funds.</p></section>
