@model TournamentDirectoryViewModel
@{ ViewData["Title"] = "Tournaments"; }
<section class="hero"><div><p class="eyebrow">Pocket Rankings Tournament</p><h1>Find your next match.</h1><p>Live brackets, table calls, results, and event details for your local pool community.</p></div><div class="hero-ball" aria-hidden="true"><span>9</span></div></section>
<section class="page-section" aria-labelledby="live-heading">
  <div class="section-heading"><div><p class="eyebrow">Happening now</p><h2 id="live-heading">Live tournaments</h2></div><span class="count-pill">@Model.Active.Count live</span></div>
  <div class="event-grid">@foreach (var tournament in Model.Active) { <article class="event-card live-card"><div class="card-topline"><span class="status live">Live</span><span>@tournament.StartsAt.ToString("ddd, MMM d · h:mm tt")</span></div><h3><a href="/tournaments/@tournament.Id">@tournament.Name</a></h3><p>@tournament.Venue · @tournament.Locality</p>@foreach (var competition in tournament.Competitions) { <div class="format-row"><span class="ball-badge">@(competition.Discipline == PoolDiscipline.NineBall ? "9" : "8")</span><span><strong>@competition.Name</strong><small>@TournamentLabels.Format(competition.Format) · Race to @competition.WinnersRaceTo</small></span><a href="/tournaments/@tournament.Id?competitionId=@competition.Id">View bracket</a></div> }</article> }</div>
</section>
<section class="page-section" id="upcoming" aria-labelledby="upcoming-heading"><div class="section-heading"><div><p class="eyebrow">Plan ahead</p><h2 id="upcoming-heading">Upcoming</h2></div></div><div class="event-grid">@foreach (var tournament in Model.Upcoming) { <article class="event-card"><div class="card-topline"><span class="status registration">Registration open</span><span>@tournament.StartsAt.ToString("ddd, MMM d · h:mm tt")</span></div><h3><a href="/tournaments/@tournament.Id">@tournament.Name</a></h3><p>@tournament.Venue · @tournament.Locality</p><p>@tournament.Description</p></article> }</div></section>
<section class="page-section format-section" id="formats" aria-labelledby="formats-heading"><p class="eyebrow">Made for the way your room plays</p><h2 id="formats-heading">More than one kind of bracket</h2><div class="feature-grid"><article><strong>Pool-first rules</strong><span>8-ball, 9-ball, 10-ball, one-pocket, banks, straight pool, blackball, and custom house formats.</span></article><article><strong>Flexible competition</strong><span>Elimination now, with round robin, Swiss, and group-to-finals built into the roadmap.</span></article><article><strong>Venue ready</strong><span>Designed around check-in, table calls, handicaps, short races, and phones at local events.</span></article></div></section>
